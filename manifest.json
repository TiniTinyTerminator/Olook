{
  "schemaVersion": 1,
  "id": "ttt.olook",
  "name": "Olook",
  "version": "1.2.1",
  "author": "TiniTinyTerminator",
  "license": "MIT",
  "description": "Olook: an Outlook-style mail client for Omarchy — Gmail, Outlook.com, Microsoft 365 and any IMAP server, with calendar and contacts, a mail panel in the bar, and pictures blocked until you allow them.",
  "kinds": [
    "bar-widget",
    "overlay"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "barWidget": "ui/Panel.qml",
    "overlay": "ui/MailWindow.qml"
  },
  "barWidget": {
    "displayName": "Olook",
    "description": "New mail at a glance, the latest messages from every inbox, and one click into Olook.",
    "category": "Communication",
    "aliases": [
      "olook",
      "mail",
      "email",
      "inbox"
    ],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "syncIntervalSec": 180,
      "notify": true,
      "panelMessageCount": 8,
      "unreadOnlyBadge": false,
      "badge": "Dot when new mail arrives"
    },
    "schema": [
      {
        "key": "syncIntervalSec",
        "type": "integer",
        "label": "Check for mail every (seconds)",
        "min": 30,
        "max": 3600,
        "step": 30,
        "defaultValue": 180
      },
      {
        "key": "notify",
        "type": "boolean",
        "label": "Desktop notification on new mail",
        "defaultValue": true
      },
      {
        "key": "panelMessageCount",
        "type": "integer",
        "label": "Messages in the bar panel",
        "min": 3,
        "max": 20,
        "step": 1,
        "defaultValue": 8
      },
      {
        "key": "badge",
        "type": "enum",
        "label": "Badge on the icon",
        "options": [
          "Dot when new mail arrives",
          "Unread count",
          "Nothing"
        ],
        "defaultValue": "Dot when new mail arrives",
        "description": "The dot clears when you open the panel; the count is everything unread."
      },
      {
        "key": "unreadOnlyBadge",
        "type": "boolean",
        "label": "Hide the icon when nothing is unread",
        "defaultValue": false
      }
    ]
  }
}
